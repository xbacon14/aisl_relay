# ---- shared by every app ----
# Base URL of the backend (or the mock while the backend is not ready)
RELAY_API_URL=http://localhost:3000
# Shared secret sent as X-Relay-Key. Leave empty to disable auth (local dev).
RELAY_API_KEY=

# ---- backend ----
PORT=3000
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
MODEL=openai/gpt-5.6-sol

# ---- alexa ----
# nothing extra: the skill only needs RELAY_API_URL / RELAY_API_KEY
