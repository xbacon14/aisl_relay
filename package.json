{
  "name": "relay",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mock": "npm run mock -w @relay/contract",
    "contract:test": "npm run test -w @relay/contract",
    "verify": "npm run build -w @relay/contract && npm run typecheck && npm run contract:test",
    "dev:backend": "npm run dev -w @relay/backend",
    "dev:telegram": "npm run dev -w @relay/telegram",
    "dev:alexa": "npm run dev -w @relay/alexa"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
