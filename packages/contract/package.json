{
  "name": "@relay/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./mock": {
      "types": "./dist/mock-server.d.ts",
      "import": "./dist/mock-server.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mock": "tsx src/mock-server.ts",
    "test": "tsx src/contract.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21"
  }
}
